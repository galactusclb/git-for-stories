model Branch {
  id                 String  @id @default(uuid())
  storyId            String
  name               String
  headCommitId       String?
  forkedFromCommitId String?

  Story Story @relation(fields: [storyId], references: [id], onDelete: Restrict)
  headCommit       Commit?  @relation("BranchHead", fields: [headCommitId], references: [id], onDelete: Restrict)
  forkedFromCommit Commit?  @relation("BranchFork", fields: [forkedFromCommitId], references: [id], onDelete: Restrict)
  commits          Commit[] @relation("CommitBranch")

  @@index([storyId])
}

model Commit {
  id            String  @id @default(uuid())
  branchId      String
  parentId      String?
  mergeParentId String?
  sceneId       String?

  branch Branch @relation("CommitBranch", fields: [branchId], references: [id], onDelete: Restrict)
  scene  Scene?  @relation(fields: [sceneId], references: [id], onDelete: Restrict)

  parent   Commit?  @relation("CommitParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Commit[] @relation("CommitParent")

  mergeParent   Commit?  @relation("CommitMergeParent", fields: [mergeParentId], references: [id], onDelete: Restrict)
  mergeChildren Commit[] @relation("CommitMergeParent")

  facts        Fact[]
  headOfBranch Branch[] @relation("BranchHead")
  forkPointOf  Branch[] @relation("BranchFork")

  @@index([branchId])
  @@index([parentId])
  @@index([mergeParentId])
  @@index([sceneId])
}
